# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# --- Runtime data / volumes ---
data/volumes/
**/data/raw/
**/data/processed/
models/
*.gguf
*.safetensors

# --- Load test & eval outputs ---
