# Normalize line endings; shell scripts and container files must stay LF
* text=auto eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.pdf binary

# Raw tool output (pytest summary lines start with "======= "): do not flag them as
# merge-conflict markers in git diff --check.
reports/raw/** conflict-marker-size=32
