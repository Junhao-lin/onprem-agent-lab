# Copy to .env and replace every "change-me" value:
#   cp .env.example .env
# Generate random secrets with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# .env is git-ignored. Never commit real values.

# --- PostgreSQL (LiteLLM metadata: keys, spend, logs) ---
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=litellm

# --- Redis (LiteLLM rate-limit counters / cache) ---
REDIS_PASSWORD=change-me

# --- LiteLLM Proxy ---
# Master key must start with "sk-"
LITELLM_MASTER_KEY=sk-change-me
# Used to encrypt provider credentials stored in DB; do not change after first start
LITELLM_SALT_KEY=change-me
LITELLM_PORT=4000

# --- Inference (Ollama) ---
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=bge-m3
# Optional tuning (defaults shown)
# OLLAMA_NUM_PARALLEL=4
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_KEEP_ALIVE=30m

# --- Qdrant ---
QDRANT_API_KEY=change-me

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Per-app virtual keys (filled by scripts/bootstrap_keys.py) ---
SUPPORT_RAG_LLM_KEY=
ONBOARDING_AGENT_LLM_KEY=
